# Server-side only. Configure these values in Vercel; never prefix them with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
JWT_SECRET=replace-with-a-long-random-api-session-secret
FRONTEND_URL=https://your-app.vercel.app

# Optional password reset email delivery through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sports Match <no-reply@example.com>

# Public browser values. These are safe to expose and belong in front-end/.env.production.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-anon-key
